{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aelev.example/contracts/opaque-translation-v1.json",
  "title": "AELEV opaque translation provider v1",
  "type": "object",
  "required": ["request", "success"],
  "additionalProperties": false,
  "properties": {
    "request": { "$ref": "#/$defs/request" },
    "success": { "$ref": "#/$defs/success" }
  },
  "$defs": {
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$"
    },
    "request": {
      "type": "object",
      "required": [
        "schema_version",
        "source_language",
        "target_language",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "source_language": { "$ref": "#/$defs/language" },
        "target_language": { "$ref": "#/$defs/language" },
        "text": { "type": "string", "minLength": 1, "maxLength": 12000 }
      }
    },
    "success": {
      "type": "object",
      "required": ["schema_version", "translated_text", "warnings"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "translated_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48000
        },
        "warnings": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    }
  }
}
