AELEV_INFRASTRUCTURE_TRANSLATOR_COMPUTE_COMPOSE_PROJECT=aelev-translator-compute
AELEV_INFRASTRUCTURE_TRANSLATOR_COMPUTE_IMAGE=REPLACE_WITH_EXACT_ADMITTED_TRANSLATOR_COMPUTE_IMAGE
AELEV_INFRASTRUCTURE_TRANSLATOR_ENVIRONMENT=production
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_HOST=REPLACE_WITH_ROUTED_TRANSLATOR_DATABASE_HOST
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_PORT=5432
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_NAME=translator_service
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_USER=translator_service
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_SSLMODE=verify-full
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_CA_FILE=ca.crt
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_CLIENT_CERT_FILE=client.crt
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_CLIENT_KEY_FILE=client.key
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_SECRET_ROOT=./secrets/database
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_NETWORK=REPLACE_WITH_ROUTED_TRANSLATOR_DATABASE_NETWORK
AELEV_INFRASTRUCTURE_TRANSLATOR_OTLP_HTTP_ENDPOINT=https://REPLACE_WITH_TELEMETRY_DELIVERY:4318
AELEV_INFRASTRUCTURE_TRANSLATOR_TELEMETRY_SECRET_ROOT=./secrets/telemetry
AELEV_INFRASTRUCTURE_TRANSLATOR_TELEMETRY_NETWORK=REPLACE_WITH_ROUTED_TRANSLATOR_TELEMETRY_NETWORK
AELEV_INFRASTRUCTURE_TRANSLATOR_PRESENCE_INTERVAL_SECONDS=10
AELEV_INFRASTRUCTURE_TRANSLATOR_PRESENCE_TTL_SECONDS=30
AELEV_INFRASTRUCTURE_TRANSLATOR_MODEL_BATCH_SIZE=1
AELEV_INFRASTRUCTURE_TRANSLATOR_MODEL_STARTUP_TIMEOUT_SECONDS=600
AELEV_INFRASTRUCTURE_TRANSLATOR_REQUEST_TIMEOUT_SECONDS=240
AELEV_INFRASTRUCTURE_TRANSLATOR_SEGMENT_TIMEOUT_SECONDS=180
AELEV_INFRASTRUCTURE_TRANSLATOR_HIGH_PRIORITY_BURST=4
AELEV_INFRASTRUCTURE_TRANSLATOR_MODEL_MEMORY_LIMIT=8g
AELEV_INFRASTRUCTURE_TRANSLATOR_MODEL_CPUS=2
AELEV_INFRASTRUCTURE_TRANSLATOR_ROLE_MEMORY_LIMIT=256m
AELEV_INFRASTRUCTURE_TRANSLATOR_ROLE_CPUS=0.25
AELEV_INFRASTRUCTURE_TRANSLATOR_MODEL_RESTART_POLICY=on-failure:3
AELEV_INFRASTRUCTURE_TRANSLATOR_RESTART_POLICY=on-failure:3
