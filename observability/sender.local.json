{
  "mode": "sender",
  "listen_host": "0.0.0.0",
  "listen_port": 4318,
  "health_port": 13134,
  "journal": "/var/lib/delivery",
  "capacity_bytes": 1073741824,
  "request_bytes": 4194304,
  "retry_seconds": 2,
  "timeout_seconds": 10,
  "server_cert": "/run/secrets/telemetry/sender/sender.crt",
  "server_key": "/run/secrets/telemetry/sender/sender.key",
  "client_ca": "/run/secrets/telemetry/sender/local-write-ca.crt",
  "ca": "/run/secrets/telemetry/sender/central-ca.crt",
  "client_cert": "/run/secrets/telemetry/sender/central-write.crt",
  "client_key": "/run/secrets/telemetry/sender/central-write.key",
  "health_ca": "/run/secrets/telemetry/sender/health-ca.crt",
  "health_cert": "/run/secrets/telemetry/sender/local-query.crt",
  "health_key": "/run/secrets/telemetry/sender/local-query.key",
  "destinations": {
    "logs": "https://delivery:4318/v1/logs",
    "traces": "https://delivery:4318/v1/traces",
    "metrics": "https://delivery:4318/api/v1/write",
    "otlp_metrics": "https://delivery:4318/v1/metrics"
  },
  "prometheus_command": [
    "/bin/prometheus",
    "--config.file=/etc/aelev/prometheus.yml",
    "--storage.tsdb.path=/var/lib/delivery/prometheus",
    "--storage.tsdb.retention.time=30d",
    "--log.format=json",
    "--web.listen-address=127.0.0.1:9090"
  ]
}
