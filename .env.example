# Допустимые значения: local (локальные послабления) или production (обязательные TLS/mTLS и телеметрия).
AELEV_INFRASTRUCTURE_TRANSLATOR_ENVIRONMENT=local
AELEV_INFRASTRUCTURE_TRANSLATOR_COMPOSE_PROJECT=aelev-infrastructure-translator
AELEV_INFRASTRUCTURE_TRANSLATOR_COMPUTE_COMPOSE_PROJECT=aelev-infrastructure-translator-compute
AELEV_INFRASTRUCTURE_TRANSLATOR_KAFKA_ENV_FILE=../kafka/.env
AELEV_INFRASTRUCTURE_TRANSLATOR_BUILD_CONTEXT=.
AELEV_INFRASTRUCTURE_TRANSLATOR_IMAGE=aelev/translator-service:index-9b-v1
# Вычислительная станция принимает только отдельный immutable image reference name@sha256.
AELEV_INFRASTRUCTURE_TRANSLATOR_COMPUTE_IMAGE=REPLACE_WITH_EXACT_ADMITTED_TRANSLATOR_COMPUTE_IMAGE
AELEV_INFRASTRUCTURE_TRANSLATOR_UI_IMAGE=aelev/translator-service-status:1.1.2
AELEV_INFRASTRUCTURE_TRANSLATOR_BACKGROUND_IMAGE=aelev/translator-service:index-9b-v1
# Optional inherited remaining native restart allowance; empty keeps RESTART_POLICY.
AELEV_INFRASTRUCTURE_TRANSLATOR_MODEL_RESTART_POLICY=
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_IMAGE=postgres:17.6-alpine
# Для новой установки — максимум три аварийные попытки. При обслуживании сохраняйте прежний меньший остаток либо no; бюджет не сбрасывается.
AELEV_INFRASTRUCTURE_TRANSLATOR_RESTART_POLICY=on-failure:3
AELEV_INFRASTRUCTURE_TRANSLATOR_UI_RESTART_POLICY=on-failure:3
AELEV_INFRASTRUCTURE_TRANSLATOR_TELEMETRY_RESTART_POLICY=on-failure:3
AELEV_INFRASTRUCTURE_TRANSLATOR_TOPIC_PROVISIONER_RESTART_POLICY=on-failure:3
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_HOST=translator-database
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_PORT=5432
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_NAME=translator_service
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_USER=translator_service
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_SSLMODE=disable
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_CA_FILE=NONE
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_CLIENT_CERT_FILE=NONE
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_CLIENT_KEY_FILE=NONE
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_SECRET_ROOT=./secrets/database
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_VOLUME=aelev-infrastructure-translator-database
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_NETWORK=aelev-infrastructure-translator-data
